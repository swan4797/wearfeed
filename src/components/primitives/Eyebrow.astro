---
// Small uppercase label above a section or block. Colour is driven by an
// inherited custom property so dark contexts can retint it:
//   --eyebrow-color
interface Props {
	as?: keyof HTMLElementTagNameMap;
	class?: string;
}
const { as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['eyebrow', className]}><slot /></Tag>

<style>
	.eyebrow {
		margin: 0;
		font-size: var(--fs-eyebrow);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--eyebrow-color, var(--grey));
	}
</style>
