---
// The "Feed®" wordmark. Structure only — size, tracking and weight are driven
// by inherited custom properties the parent section sets:
//   --brand-size, --brand-tracking, --brand-weight
import { site } from '../../config/site';

interface Props {
	as?: keyof HTMLElementTagNameMap;
	class?: string;
}
const { as: Tag = 'span', class: className } = Astro.props;
---

<Tag class:list={['brand', className]}>{site.brand.word}<span class="mark"
	>{site.brand.dot}</span
	></Tag>

<style>
	.brand {
		display: inline-block;
		margin: 0;
		font-family: var(--font-display);
		font-weight: var(--brand-weight, 800);
		text-transform: uppercase;
		font-size: 2rem;
		line-height: 1;
		letter-spacing: var(--brand-tracking, 0.06em);
	}
	.mark {
		font-size: 0.52em;
		font-weight: 600;
		vertical-align: super;
	}
</style>
