---
// Centered max-width container. `as` sets the wrapping element so it can carry
// the right landmark (e.g. <header>, <footer>) when needed.
interface Props {
	as?: keyof HTMLElementTagNameMap;
	class?: string;
}
const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['wrap', className]}><slot /></Tag>

<style>
	.wrap {
		width: 100%;
		max-width: var(--container);
		margin-inline: auto;
		padding-inline: var(--wrap-pad);
	}
</style>
