---
// Full-screen burger menu. Zero JavaScript: the trigger links to #site-menu
// and the overlay opens via :target, revealed by a clip-path circle that
// grows from the trigger's corner to cover the screen. Clicking a menu link
// changes the hash, which closes the overlay and scrolls to the section in
// one native step; the close link points at a non-existent fragment so it
// clears :target without scrolling. The expand/collapse transition is
// disabled under prefers-reduced-motion (the menu still opens, instantly).
import Eyebrow from '../primitives/Eyebrow.astro';
import { site } from '../../config/site';
---

<a class="open" href="#site-menu">
	{site.menu.trigger}
	<span class="open__icon" aria-hidden="true">
		<span class="line"></span>
		<span class="line line--mid"></span>
		<span class="line"></span>
	</span>
</a>

<div class="menu" id="site-menu">
	<a class="close" href="#!" aria-label="Close menu">
		{site.menu.trigger}
		<svg aria-hidden="true" viewBox="0 0 14 14" fill="none">
			<path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5"
			></path>
		</svg>
	</a>

	<div class="menu__grid">
		<nav class="menu__nav" aria-label="Site menu">
			{site.menu.links.map((item) => <a href={item.href}>{item.label}</a>)}
		</nav>

		<div class="menu__contact">
			<div>
				<Eyebrow>{site.menu.write}</Eyebrow>
				<a class="menu__mail" href="mailto:">{site.email}</a>
			</div>
			<div>
				<Eyebrow>{site.menu.call}</Eyebrow>
				<a class="menu__tel" href={site.phone.href}>{site.phone.label}</a>
				<p class="menu__where">{site.areaCovered}</p>
			</div>
		</div>
	</div>
</div>

<style>
	.open,
	.close {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		font-size: var(--fs-dish);
		font-weight: 500;
		letter-spacing: 0.01em;
		text-decoration: none;
	}
	.close svg {
		width: 1rem;
	}

	/* Burger: three rounded lines, the middle one short (left-aligned). */
	.open__icon {
		display: inline-flex;
		flex-direction: column;
		justify-content: space-between;
		width: 1.75rem;
		height: 1rem;
		padding-block: 1px;
	}
	.line {
		display: block;
		width: 100%;
		height: 2px;
		border-radius: 999px;
		background: currentColor;
		transform: scaleX(var(--s, 1));
		transform-origin: 0 50%;
	}
	.line--mid {
		--s: 0.64;
	}

	/* Hover: each line wipes out to the right and back in from the left,
	   staggered top to bottom. Ends exactly at its resting width. */
	.open:hover .line {
		animation: wipe 0.45s cubic-bezier(0.55, 0, 0.15, 1) both;
	}
	.open:hover .line:nth-child(2) {
		animation-delay: 0.07s;
	}
	.open:hover .line:nth-child(3) {
		animation-delay: 0.14s;
	}
	@keyframes wipe {
		0% {
			transform: scaleX(var(--s, 1));
			transform-origin: 100% 50%;
		}
		49.9% {
			transform: scaleX(0);
			transform-origin: 100% 50%;
		}
		50.1% {
			transform: scaleX(0);
			transform-origin: 0 50%;
		}
		100% {
			transform: scaleX(var(--s, 1));
			transform-origin: 0 50%;
		}
	}

	.menu {
		position: fixed;
		inset: 0;
		z-index: 20;
		background: var(--ink);
		color: var(--bg);
		padding: var(--pad);
		overflow-y: auto;
		/* Collapsed: a zero-radius circle anchored at the trigger's corner. */
		clip-path: circle(0% at calc(100% - var(--pad)) 2.4rem);
		visibility: hidden;
		transition:
			clip-path 0.65s cubic-bezier(0.55, 0, 0.15, 1),
			visibility 0s linear 0.65s;
	}
	.menu:target {
		clip-path: circle(150% at calc(100% - var(--pad)) 2.4rem);
		visibility: visible;
		transition: clip-path 0.65s cubic-bezier(0.55, 0, 0.15, 1);
	}

	.close {
		position: absolute;
		top: 1.7rem;
		right: var(--pad);
	}

	.menu__grid {
		min-height: calc(100dvh - 2 * var(--pad));
		display: grid;
		gap: var(--space-2xl) var(--pad);
		align-content: center;
	}
	.menu__nav a {
		display: block;
		width: fit-content;
		font-family: var(--font-display);
		font-size: var(--fs-menu);
		font-weight: 650;
		letter-spacing: -0.035em;
		line-height: 1.22;
		text-decoration: none;
	}
	.menu__nav a:hover {
		color: var(--muted-on-dark);
	}

	.menu__contact {
		--eyebrow-color: var(--grey-on-dark);
	}
	.menu__contact > div + div {
		margin-top: 2.2rem;
	}
	.menu__mail {
		display: inline-block;
		margin-top: 0.8rem;
		font-size: var(--fs-mail);
		font-weight: 600;
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	.menu__tel {
		display: inline-block;
		margin-top: 0.8rem;
		font-size: var(--fs-dish);
		font-weight: 500;
		text-decoration: none;
	}
	.menu__mail:hover,
	.menu__tel:hover {
		color: var(--muted-on-dark);
	}
	.menu__where {
		margin-top: 0.4rem;
		font-size: var(--fs-dish);
		line-height: 1.6;
		color: var(--muted-on-dark);
	}

	@media (min-width: 861px) {
		.menu__grid {
			grid-template-columns: 1.2fr 1fr;
			align-items: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.menu,
		.menu:target {
			transition: none;
		}
		.open:hover .line {
			animation: none;
		}
	}
</style>

<style is:global>
	/* Lock page scroll behind the open menu. */
	body:has(#site-menu:target) {
		overflow: hidden;
	}
</style>
