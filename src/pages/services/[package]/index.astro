---
// Package overview page: hero (headline + intro), then the package's
// services as ruled link rows. One page per package, prerendered.
export const prerender = true;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopBar from '../../../components/sections/TopBar.astro';
import Hero from '../../../components/sections/Hero.astro';
import Footer from '../../../components/sections/Footer.astro';
import Modal from '../../../components/primitives/Modal.astro';
import ContactForm from '../../../components/primitives/ContactForm.astro';
import Breadcrumb from '../../../components/primitives/Breadcrumb.astro';
import Wrap from '../../../components/primitives/Wrap.astro';
import Eyebrow from '../../../components/primitives/Eyebrow.astro';
import LinkRows from '../../../components/primitives/LinkRows.astro';
import { getImage } from 'astro:assets';
import { servicePackages, serviceHref } from '../../../data/services';
import type { ServicePackage } from '../../../types/content';

export function getStaticPaths() {
	return servicePackages.map((pkg) => ({
		params: { package: pkg.slug },
		props: { pkg },
	}));
}

interface Props {
	pkg: ServicePackage;
}
const { pkg } = Astro.props;
const label = `${pkg.number} — ${pkg.title}`;
const heroImage = await getImage({ src: pkg.image, width: 1920, format: 'webp' });
---

<BaseLayout
	title={`${label} — restaurant consulting — Feed®`}
	description={pkg.intro}
>
	<TopBar />
	<main id="main">
		<div class="top">
			<Hero
				content={{
					eyebrow: label,
					h1: pkg.headline,
					sub: pkg.intro,
					cta: {
						label: 'Book a visit',
						href: '#contact',
						aside: '',
						modal: 'contact-modal',
					},
				}}
				background={{ type: 'image', src: heroImage.src }}
				headingAs="h1"
				headingPosition="bottom"
			/>
		</div>

		<div class="crumb-band">
			<Wrap>
				<Breadcrumb items={[{ label: 'Services', href: '/#packages' }, { label }]} />
			</Wrap>
		</div>

		<section class="list">
			<Wrap>
				<Eyebrow>{`What's in ${pkg.title}`}</Eyebrow>
				<div class="list__rows">
					<LinkRows
						rows={pkg.services.map((service) => ({
							label: service.title,
							href: serviceHref(pkg, service),
							note: service.summary,
						}))}
					/>
				</div>
			</Wrap>
		</section>
	</main>
	<Footer />

	<Modal id="contact-modal" type="slide-over" label="Contact">
		<ContactForm />
	</Modal>
</BaseLayout>

<style>
	/* Package headlines step down from the landing's display size; the
	   hero's own masthead clearance and the locked-screen transition
	   behave as on the landing page. */
	.top :global(.hero__intro) {
		--heading-size: var(--fs-contact);
		--heading-measure: 24ch;
	}

	.crumb-band {
		padding-top: clamp(1.5rem, 3vw, 2.5rem);
	}

	.list {
		padding-bottom: var(--sect-sm);
	}
	.list__rows {
		margin-top: var(--space-md);
		max-width: 52rem;
	}
</style>
