---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/sections/TopBar.astro';
import Hero from '../components/sections/Hero.astro';
import Statement from '../components/sections/Statement.astro';
import Packages from '../components/sections/Packages.astro';
import WorkGrid from '../components/sections/WorkGrid.astro';
import GhostBand from '../components/sections/GhostBand.astro';
import Footer from '../components/sections/Footer.astro';
import Modal from '../components/primitives/Modal.astro';
import ContactForm from '../components/primitives/ContactForm.astro';
import { hero } from '../data/hero';
import { menu } from '../data/menu';
import { work } from '../data/work';
import heroVideo from '../assets/videos/4253330-uhd_4096_2160_25fps.mp4';
---

<BaseLayout>
	<TopBar />
	<main id="main">
		<Hero content={hero} sheet={menu} background={{ type: 'video', src: heroVideo }} headingPosition="center"/>
		<WorkGrid content={work} />
		<Statement />
		<Packages />
		<GhostBand />
	</main>
	<Footer />

	<Modal id="contact-modal" type="slide-over" label="Contact">
		<ContactForm />
	</Modal>
</BaseLayout>
